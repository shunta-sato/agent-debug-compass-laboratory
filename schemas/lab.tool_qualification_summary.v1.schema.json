{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.tool_qualification_summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "tools", "qualification_refs", "evidence_accepted_tool_ids", "evidence_rejected_tool_ids", "missing_tool_ids", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.tool_qualification_summary.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "status", "evidence_accepted"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["builtin", "builtin_bounded", "needs_control_test", "external_unqualified", "agent_created_unqualified", "qualified", "refused"] },
          "evidence_accepted": { "type": "boolean" }
        }
      }
    },
    "qualification_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_accepted_tool_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_rejected_tool_ids": { "type": "array", "items": { "type": "string" } },
    "missing_tool_ids": { "type": "array", "items": { "type": "string" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
