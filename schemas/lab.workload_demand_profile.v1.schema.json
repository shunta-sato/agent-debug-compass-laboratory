{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.workload_demand_profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "run_id", "workload_id", "target_id", "execution_mode", "demand_scope", "workload_demand", "target_conditioned_response", "system_context", "data_quality", "evidence_refs", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.workload_demand_profile.v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "workload_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["local", "target_local"] },
    "demand_scope": { "enum": ["process_scoped", "system_wide_only"] },
    "workload_demand": { "$ref": "#/$defs/workload_demand" },
    "target_conditioned_response": { "$ref": "#/$defs/target_response" },
    "system_context": { "$ref": "#/$defs/system_context" },
    "data_quality": { "$ref": "#/$defs/data_quality" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "nullable_number": { "type": ["number", "null"] },
    "nullable_integer": { "type": ["integer", "null"], "minimum": 0 },
    "workload_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_cpu_utime_ticks", "process_cpu_stime_ticks", "process_cpu_time_ms", "process_cpu_percent_avg", "process_cpu_percent_peak", "rss_peak_kb", "vmhwm_peak_kb", "read_bytes", "write_bytes", "cancelled_write_bytes", "voluntary_ctxt_switches", "nonvoluntary_ctxt_switches", "duty_cycle", "child_process_accounting_status"],
      "properties": {
        "process_cpu_utime_ticks": { "$ref": "#/$defs/nullable_integer" },
        "process_cpu_stime_ticks": { "$ref": "#/$defs/nullable_integer" },
        "process_cpu_time_ms": { "$ref": "#/$defs/nullable_number" },
        "process_cpu_percent_avg": { "$ref": "#/$defs/nullable_number" },
        "process_cpu_percent_peak": { "$ref": "#/$defs/nullable_number" },
        "rss_peak_kb": { "$ref": "#/$defs/nullable_integer" },
        "vmhwm_peak_kb": { "$ref": "#/$defs/nullable_integer" },
        "read_bytes": { "$ref": "#/$defs/nullable_integer" },
        "write_bytes": { "$ref": "#/$defs/nullable_integer" },
        "cancelled_write_bytes": { "$ref": "#/$defs/nullable_integer" },
        "voluntary_ctxt_switches": { "$ref": "#/$defs/nullable_integer" },
        "nonvoluntary_ctxt_switches": { "$ref": "#/$defs/nullable_integer" },
        "duty_cycle": { "type": "string", "minLength": 1 },
        "child_process_accounting_status": { "type": "string", "minLength": 1 }
      }
    },
    "target_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_between_targets", "thermal_max_c", "thermal_margin_c", "freq_range_khz", "abort_reason"],
      "properties": {
        "portable_between_targets": { "const": false },
        "thermal_max_c": { "type": ["number", "null"] },
        "thermal_margin_c": { "type": ["number", "null"] },
        "freq_range_khz": {
          "anyOf": [
            { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
            { "type": "null" }
          ]
        },
        "abort_reason": { "type": ["string", "null"] }
      }
    },
    "system_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_cpu_percent_avg", "system_memory_available_min_kb", "background_activity_confounder"],
      "properties": {
        "system_cpu_percent_avg": { "type": ["number", "null"] },
        "system_memory_available_min_kb": { "$ref": "#/$defs/nullable_integer" },
        "background_activity_confounder": { "type": "string", "minLength": 1 }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degraded", "missing", "notes"],
      "properties": {
        "degraded": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
