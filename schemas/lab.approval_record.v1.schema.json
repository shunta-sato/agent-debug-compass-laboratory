{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.approval_record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "target_id", "risk_tier", "operation_summary", "approved_plan_id", "approved_plan_digest", "approved_operation", "approved_by", "bounds", "restore_required", "approved_actions", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.approval_record.v1" },
    "approval_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "risk_tier": { "enum": ["tier2_privileged_reversible", "tier3_hard_to_restore"] },
    "operation_summary": { "type": "string", "minLength": 1 },
    "approved_plan_id": { "type": "string", "minLength": 1 },
    "approved_plan_digest": { "type": "string", "minLength": 8 },
    "approved_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "desired_state"],
      "properties": {
        "operation_id": { "enum": ["linux.cpufreq.set_governor"] },
        "desired_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governor"],
          "properties": {
            "governor": { "enum": ["performance", "ondemand", "powersave", "schedutil", "userspace"] }
          }
        }
      }
    },
    "approved_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["human"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds_max", "thermal_celsius_abort"],
      "properties": {
        "duration_seconds_max": { "type": "integer", "minimum": 1 },
        "thermal_celsius_abort": { "type": ["number", "null"] }
      }
    },
    "restore_required": { "type": "boolean" },
    "approved_actions": { "type": "array", "items": { "enum": ["linux.cpufreq.set_governor"] } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
