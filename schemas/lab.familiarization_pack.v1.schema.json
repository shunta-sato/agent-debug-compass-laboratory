{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.familiarization_pack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target_id", "pack_status", "operations_summary", "artifact_refs", "supported_claims", "blocked_claims", "next_evidence_needed", "audit_event_count", "restore_status", "claim_trace_ref", "tool_qualification_summary_ref", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.familiarization_pack.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "pack_status": { "enum": ["observational_read_only", "read_only_plus_bounded_load", "exploratory_short_smoke", "controlled_operating_point_subset", "formal_comparison_candidate", "incomplete"] },
    "operations_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "toolchain_discovery", "passive_observe", "bounded_load", "privileged_control", "controlled_operating_point", "sustained_thermal"],
      "properties": {
        "inventory": { "enum": ["completed", "not_run"] },
        "toolchain_discovery": { "enum": ["completed", "not_run"] },
        "passive_observe": { "enum": ["completed", "not_run"] },
        "bounded_load": { "enum": ["completed", "not_run"] },
        "privileged_control": { "enum": ["completed", "not_run"] },
        "controlled_operating_point": { "enum": ["completed", "not_run"] },
        "sustained_thermal": { "enum": ["completed", "not_run"] }
      }
    },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "supported_claims": { "type": "array", "items": { "type": "string" } },
    "blocked_claims": { "type": "array", "items": { "type": "string" } },
    "next_evidence_needed": { "type": "array", "items": { "type": "string" } },
    "audit_event_count": { "type": "integer", "minimum": 0 },
    "restore_status": { "enum": ["not_required", "pending_or_recorded", "restored", "failed"] },
    "claim_trace_ref": { "type": ["string", "null"] },
    "tool_qualification_summary_ref": { "type": ["string", "null"] },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
