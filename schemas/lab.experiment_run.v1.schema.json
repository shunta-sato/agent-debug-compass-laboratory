{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.experiment_run.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "matrix_id", "target_id", "dry_run", "trials", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.experiment_run.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "matrix_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean" },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "factors", "status"],
        "properties": {
          "trial_id": { "type": "string", "minLength": 1 },
          "factors": { "type": "object", "additionalProperties": { "type": "string" } },
          "status": { "enum": ["planned", "completed", "failed", "blocked", "not_implemented"] }
        }
      }
    },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
