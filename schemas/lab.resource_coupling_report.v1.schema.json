{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.resource_coupling_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "target_id", "report_status", "chains", "evidence_refs", "unknowns", "next_evidence_needed", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.resource_coupling_report.v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "report_status": { "$ref": "#/$defs/status" },
    "chains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chain" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "next_evidence_needed": { "type": "array", "items": { "type": "string" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "status": {
      "enum": ["measured", "measured_partial", "not_controllable", "unsafe_to_run_with_reason", "not_applicable_with_reason", "insufficient"]
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "pressure", "platform_response", "secondary_pressure", "performance_degradation", "recovery_behavior", "status", "evidence_refs"],
      "properties": {
        "chain_id": { "type": "string", "minLength": 1 },
        "pressure": { "type": "string", "minLength": 1 },
        "platform_response": { "type": "string", "minLength": 1 },
        "secondary_pressure": { "type": "string", "minLength": 1 },
        "performance_degradation": { "type": "string", "minLength": 1 },
        "recovery_behavior": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
