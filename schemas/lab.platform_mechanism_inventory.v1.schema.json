{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.platform_mechanism_inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "target_class", "mechanisms", "evidence_refs", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.platform_mechanism_inventory.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "target_class": { "type": "string", "minLength": 1 },
    "mechanisms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mechanism" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "status": {
      "enum": ["measured", "measured_partial", "not_controllable", "unsafe_to_run_with_reason", "not_applicable_with_reason", "insufficient"]
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "mechanism_id", "description", "visibility_status", "control_status", "evidence_refs", "reason"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "mechanism_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "visibility_status": { "$ref": "#/$defs/status" },
        "control_status": { "$ref": "#/$defs/status" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
