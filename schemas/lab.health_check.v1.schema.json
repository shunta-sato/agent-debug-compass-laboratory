{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.health_check.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "status", "inventory_available", "toolchain_available"],
  "properties": {
    "schema_version": { "const": "lab.health_check.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ok", "degraded"] },
    "inventory_available": { "type": "boolean" },
    "toolchain_available": { "type": "boolean" }
  }
}
