{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.workload_profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "description", "workload_class", "duration_seconds", "requirements", "measurement_requirements", "claim_boundary"],
  "properties": {
    "schema_version": { "const": "lab.workload_profile.v1" },
    "workload_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "workload_class": { "enum": ["idle_observe", "synthetic_cpu", "application_workload"] },
    "duration_seconds": { "type": "integer", "minimum": 1 },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thermal_celsius_max", "max_abort_count", "memory_mb_max", "latency_p95_ms_max"],
      "properties": {
        "thermal_celsius_max": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "max_abort_count": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "memory_mb_max": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "latency_p95_ms_max": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
      }
    },
    "measurement_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim_boundary": { "enum": ["exploratory_only", "synthetic_short_smoke_only", "not_selection_evidence"] }
  }
}
