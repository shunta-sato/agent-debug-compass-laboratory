{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.workload_run_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "workload_name", "target", "execution", "bounds", "observation", "claim_boundary"],
  "properties": {
    "schema_version": { "const": "lab.workload_run_plan.v1" },
    "workload_id": { "type": "string", "minLength": 1 },
    "workload_name": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "execution": { "$ref": "#/$defs/execution" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "observation": { "$ref": "#/$defs/observation" },
    "claim_boundary": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable_path", "args", "working_directory", "expected_executable_sha256", "require_executable_sha256", "reject_setuid", "reject_world_writable", "environment_policy"],
      "properties": {
        "executable_path": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string", "minLength": 1 },
        "expected_executable_sha256": { "type": ["string", "null"] },
        "require_executable_sha256": { "type": "boolean" },
        "reject_setuid": { "type": "boolean" },
        "reject_world_writable": { "type": "boolean" },
        "environment_policy": { "$ref": "#/$defs/environment_policy" }
      },
      "not": {
        "anyOf": [
          { "required": ["shell"] },
          { "required": ["command_string"] }
        ]
      }
    },
    "environment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "allowed"],
      "properties": {
        "inherit": { "type": "boolean" },
        "allowed": { "type": "array", "items": { "$ref": "#/$defs/env_var" } }
      }
    },
    "env_var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds_max", "stdout_bytes_max", "stderr_bytes_max", "memory_bytes_max", "storage_bytes_max", "thermal_abort_c", "operator_abort_file"],
      "properties": {
        "duration_seconds_max": { "type": "integer", "minimum": 1, "maximum": 300 },
        "stdout_bytes_max": { "type": "integer", "minimum": 0 },
        "stderr_bytes_max": { "type": "integer", "minimum": 0 },
        "memory_bytes_max": { "type": "integer", "minimum": 0 },
        "storage_bytes_max": { "type": "integer", "minimum": 0 },
        "thermal_abort_c": { "type": ["number", "null"] },
        "operator_abort_file": { "type": ["string", "null"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_interval_ms", "process_scoped", "system_context"],
      "properties": {
        "sample_interval_ms": { "type": "integer", "minimum": 1 },
        "process_scoped": { "const": true },
        "system_context": { "type": "boolean" }
      }
    }
  }
}
