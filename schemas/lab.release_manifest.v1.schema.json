{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.release_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "git_sha", "target_triple", "binaries"],
  "properties": {
    "schema_version": { "const": "lab.release_manifest.v1" },
    "version": { "type": "string", "minLength": 1 },
    "git_sha": { "type": "string", "minLength": 1 },
    "target_triple": { "type": "string", "minLength": 1 },
    "binaries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {
            "enum": ["adc-lab", "adc-lab-target", "adc-lab-priv-helper"]
          },
          "sha256": { "type": "string", "minLength": 64 }
        }
      }
    }
  }
}
