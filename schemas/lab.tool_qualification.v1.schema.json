{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.tool_qualification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "category", "privilege", "source", "available", "status", "evidence_accepted", "dry_run_required", "qualification_scope", "tool_version", "tool_sha256", "output_schema_ref", "dry_run_ref", "manual_comparison_ref", "static_safety_review_ref", "validated_output_bytes", "evidence_refs", "checks", "limitations", "reason", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.tool_qualification.v1" },
    "tool_id": { "type": "string", "minLength": 1 },
    "category": { "enum": ["observation", "control", "load", "probe", "report_normalizer", "restore", "health_check", "observation_control"] },
    "privilege": { "enum": ["none", "user", "sudo_helper", "root"] },
    "source": { "enum": ["builtin", "external", "agent_created", "missing"] },
    "available": { "type": "boolean" },
    "status": { "enum": ["builtin", "needs_control_test", "external_unqualified", "agent_created_unqualified", "qualified", "refused"] },
    "evidence_accepted": { "type": "boolean" },
    "dry_run_required": { "type": "boolean" },
    "qualification_scope": { "type": "string", "minLength": 1 },
    "tool_version": { "type": ["string", "null"] },
    "tool_sha256": { "type": ["string", "null"] },
    "output_schema_ref": { "type": ["string", "null"] },
    "dry_run_ref": { "type": ["string", "null"] },
    "manual_comparison_ref": { "type": ["string", "null"] },
    "static_safety_review_ref": { "type": ["string", "null"] },
    "validated_output_bytes": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "checks": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string", "minLength": 1 },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
