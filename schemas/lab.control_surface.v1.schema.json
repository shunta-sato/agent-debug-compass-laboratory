{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.control_surface.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "surfaces"],
  "properties": {
    "schema_version": { "const": "lab.control_surface.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "available", "requires_privilege"],
        "properties": {
          "surface_id": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "requires_privilege": { "type": "boolean" }
        }
      }
    }
  }
}
