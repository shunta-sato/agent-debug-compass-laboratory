{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.privilege_provider_status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_id",
    "active_provider_id",
    "providers",
    "time_unix_ms"
  ],
  "properties": {
    "schema_version": { "const": "lab.privilege_provider_status.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "active_provider_id": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_kind",
        "availability",
        "transport",
        "endpoint",
        "root_boundary",
        "operations_allowed",
        "approval_required",
        "audit_required",
        "restore_required",
        "default_enabled",
        "safety_notes"
      ],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "provider_kind": {
          "enum": ["sudo_helper_option_a", "systemd_unix_socket_option_b"]
        },
        "availability": {
          "enum": ["active", "installed", "planned_disabled", "missing", "disabled"]
        },
        "transport": { "enum": ["sudo_exec", "unix_socket"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "root_boundary": { "type": "string", "minLength": 1 },
        "operations_allowed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "approval_required": { "type": "boolean" },
        "audit_required": { "type": "boolean" },
        "restore_required": { "type": "boolean" },
        "default_enabled": { "type": "boolean" },
        "safety_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
