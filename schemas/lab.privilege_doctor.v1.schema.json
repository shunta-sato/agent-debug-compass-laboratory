{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.privilege_doctor.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "helper_path", "helper_installed", "root_owned", "world_writable", "sudo_non_interactive_available", "helper_version", "status", "checks", "next_action", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.privilege_doctor.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "helper_path": { "type": "string", "minLength": 1 },
    "helper_installed": { "type": "boolean" },
    "root_owned": { "type": ["boolean", "null"] },
    "world_writable": { "type": ["boolean", "null"] },
    "sudo_non_interactive_available": { "type": "boolean" },
    "helper_version": { "type": ["string", "null"] },
    "status": { "enum": ["ready", "degraded", "operator_setup_required", "unsupported_target"] },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "next_action": { "type": "string", "minLength": 1 },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "summary", "evidence"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "warning", "not_applicable"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
