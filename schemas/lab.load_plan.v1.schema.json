{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.load_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "load_id", "target_id", "load_kind", "workers", "duration_seconds", "abort_temp_c", "created_by", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.load_plan.v1" },
    "load_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "load_kind": { "enum": ["cpu"] },
    "workers": { "type": "integer", "minimum": 1 },
    "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "abort_temp_c": { "type": ["number", "null"] },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["agent", "human", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
