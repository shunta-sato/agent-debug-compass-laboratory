{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.workload_run_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workload_id", "target_id", "execution_mode", "status", "reason", "exit_code", "signal", "started_at_unix_ms", "ended_at_unix_ms", "duration_ms", "stdout_ref", "stderr_ref", "stdout_truncated", "stderr_truncated", "process_ids", "audit_refs", "data_quality", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.workload_run_result.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "workload_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "enum": ["local", "target_local"] },
    "status": { "enum": ["completed", "failed", "aborted", "refused"] },
    "reason": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["integer", "null"] },
    "started_at_unix_ms": { "type": "integer", "minimum": 0 },
    "ended_at_unix_ms": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "stdout_ref": { "type": ["string", "null"] },
    "stderr_ref": { "type": ["string", "null"] },
    "stdout_truncated": { "type": "boolean" },
    "stderr_truncated": { "type": "boolean" },
    "process_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "audit_refs": { "type": "array", "items": { "type": "string" } },
    "data_quality": { "$ref": "#/$defs/data_quality" },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degraded", "missing", "notes"],
      "properties": {
        "degraded": { "type": "boolean" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
