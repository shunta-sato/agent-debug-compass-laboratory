{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact_for_RunValidationPayload",
  "type": "object",
  "required": [
    "claims",
    "data_quality",
    "evidence_refs",
    "factors",
    "id",
    "kind",
    "metrics",
    "payload",
    "run_id",
    "schema",
    "status",
    "target_id",
    "time_unix_ms"
  ],
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/definitions/Bounds"
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Claim"
      }
    },
    "data_quality": {
      "$ref": "#/definitions/DataQuality"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factors": {
      "$ref": "#/definitions/Factors"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/Kind"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Metric"
      }
    },
    "payload": {
      "$ref": "#/definitions/RunValidationPayload"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/Status"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Bounds": {
      "type": "object",
      "required": [
        "notes"
      ],
      "properties": {
        "duration_seconds_max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "decision",
        "evidence_refs",
        "next_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/Decision"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQuality": {
      "type": "object",
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "$ref": "#/definitions/DataQualityLevel"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQualityLevel": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "degraded"
      ]
    },
    "Decision": {
      "type": "string",
      "enum": [
        "supported",
        "provisional",
        "blocked"
      ]
    },
    "EvidenceRefusalCode": {
      "type": "string",
      "enum": [
        "invalid_artifact",
        "policy_violation",
        "unsupported_operation",
        "missing_evidence"
      ]
    },
    "Factors": {
      "type": "object",
      "required": [
        "confounders",
        "controlled",
        "observed"
      ],
      "properties": {
        "confounders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controlled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "GovernorValidation": {
      "type": "object",
      "required": [
        "governor",
        "messages",
        "next_evidence",
        "validity"
      ],
      "properties": {
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "control_result_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "governor": {
          "type": "string"
        },
        "health_check_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "load_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "restore_result_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "validity": {
          "$ref": "#/definitions/GovernorValidity"
        }
      },
      "additionalProperties": false
    },
    "GovernorValidity": {
      "type": "string",
      "enum": [
        "measured",
        "measured_partial",
        "insufficient",
        "refused",
        "contaminated",
        "not_applicable",
        "unknown"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "inventory",
        "observation",
        "pressure",
        "composite",
        "control_result",
        "load",
        "workload",
        "report.run",
        "report.operating_contract",
        "report.suitability",
        "report.constraints",
        "report.constraints_check",
        "report.run_validation",
        "control.governor_sweep_policy",
        "workflow.recommendation"
      ]
    },
    "Metric": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "RunValidationGap": {
      "type": "object",
      "required": [
        "code",
        "evidence_refs",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governor": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RunValidationPayload": {
      "type": "object",
      "required": [
        "audit_refs",
        "gaps",
        "governor_results",
        "overall_validity",
        "profile",
        "requested_governors"
      ],
      "properties": {
        "audit_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collect_plan_digest": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "collect_plan_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "expected_governors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RunValidationGap"
          }
        },
        "governor_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GovernorValidation"
          }
        },
        "included_run_refs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overall_validity": {
          "$ref": "#/definitions/GovernorValidity"
        },
        "profile": {
          "type": "string"
        },
        "requested_governors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject_run_set_id": {
          "default": "legacy_run_validation_missing_run_set_identity",
          "type": "string"
        },
        "target_class": {
          "default": "unknown-target-class",
          "type": "string"
        },
        "target_id": {
          "default": "unknown-target",
          "type": "string"
        },
        "validation_profile": {
          "default": "target-operating-contract-fullset",
          "type": "string"
        },
        "version_set": {
          "default": {
            "records": [],
            "skew_detected": false,
            "skew_reasons": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/RunValidationVersionSet"
            }
          ]
        },
        "version_skew_override": {
          "default": false,
          "type": "boolean"
        },
        "version_skew_policy": {
          "default": "no_skew_detected",
          "allOf": [
            {
              "$ref": "#/definitions/VersionSkewPolicyResult"
            }
          ]
        },
        "workflow_recommendation_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RunValidationVersionSet": {
      "type": "object",
      "required": [
        "records",
        "skew_detected",
        "skew_reasons"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolVersionRecord"
          }
        },
        "skew_detected": {
          "type": "boolean"
        },
        "skew_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Status": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured_partial"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "insufficient"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "not_applicable"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "$ref": "#/definitions/EvidenceRefusalCode"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "refused"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "unsafe_blocked"
              ]
            }
          }
        }
      ]
    },
    "ToolVersionRecord": {
      "type": "object",
      "required": [
        "artifact_ref",
        "build_profile",
        "git_sha",
        "role",
        "target_triple",
        "tool_name",
        "version"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string"
        },
        "build_profile": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "role": {
          "$ref": "#/definitions/ToolVersionRole"
        },
        "target_triple": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ToolVersionRole": {
      "type": "string",
      "enum": [
        "controller_adc_lab",
        "target_local_adc_lab",
        "target_runner",
        "privileged_helper",
        "release_manifest"
      ]
    },
    "VersionSkewPolicyResult": {
      "type": "string",
      "enum": [
        "no_skew_detected",
        "blocked_by_version_skew",
        "override_recorded_still_blocked"
      ]
    }
  }
}