{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact_for_WorkflowCollectPlanPayload",
  "type": "object",
  "required": [
    "claims",
    "data_quality",
    "evidence_refs",
    "factors",
    "id",
    "kind",
    "metrics",
    "payload",
    "run_id",
    "schema",
    "status",
    "target_id",
    "time_unix_ms"
  ],
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/definitions/Bounds"
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Claim"
      }
    },
    "data_quality": {
      "$ref": "#/definitions/DataQuality"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factors": {
      "$ref": "#/definitions/Factors"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/Kind"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Metric"
      }
    },
    "payload": {
      "$ref": "#/definitions/WorkflowCollectPlanPayload"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/Status"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Bounds": {
      "type": "object",
      "required": [
        "notes"
      ],
      "properties": {
        "duration_seconds_max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "BuildInfo": {
      "type": "object",
      "required": [
        "build_profile",
        "git_sha",
        "name",
        "target_triple",
        "version"
      ],
      "properties": {
        "build_profile": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "target_triple": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "decision",
        "evidence_refs",
        "next_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/Decision"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQuality": {
      "type": "object",
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "$ref": "#/definitions/DataQualityLevel"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQualityLevel": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "degraded"
      ]
    },
    "Decision": {
      "type": "string",
      "enum": [
        "supported",
        "provisional",
        "blocked"
      ]
    },
    "EvidenceRefusalCode": {
      "type": "string",
      "enum": [
        "invalid_artifact",
        "policy_violation",
        "unsupported_operation",
        "missing_evidence"
      ]
    },
    "Factors": {
      "type": "object",
      "required": [
        "confounders",
        "controlled",
        "observed"
      ],
      "properties": {
        "confounders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controlled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "GovernorValidity": {
      "type": "string",
      "enum": [
        "measured",
        "measured_partial",
        "insufficient",
        "refused",
        "contaminated",
        "not_applicable",
        "unknown"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "inventory",
        "observation",
        "pressure",
        "composite",
        "control_result",
        "load",
        "workload",
        "report.run",
        "report.operating_contract",
        "report.suitability",
        "report.constraints",
        "report.constraints_check",
        "report.run_validation",
        "control.governor_sweep_policy",
        "workflow.recommendation",
        "workflow.collect_plan"
      ]
    },
    "Metric": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Status": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured_partial"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "insufficient"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "not_applicable"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "$ref": "#/definitions/EvidenceRefusalCode"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "refused"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "unsafe_blocked"
              ]
            }
          }
        }
      ]
    },
    "WorkflowCollectPlanPayload": {
      "type": "object",
      "required": [
        "continuation_semantics",
        "controller_adc_lab",
        "expected_final_artifacts",
        "goal",
        "packaging_failure_blocks_handoff",
        "packaging_is_target_evidence",
        "planned_run_dir",
        "recommendation_mode",
        "source_of_truth_chain",
        "steps",
        "target",
        "target_class",
        "target_id",
        "workflow_id"
      ],
      "properties": {
        "continuation_semantics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowContinuationRule"
          }
        },
        "controller_adc_lab": {
          "$ref": "#/definitions/BuildInfo"
        },
        "expected_final_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "type": "string"
        },
        "packaging_failure_blocks_handoff": {
          "type": "boolean"
        },
        "packaging_is_target_evidence": {
          "type": "boolean"
        },
        "planned_run_dir": {
          "type": "string"
        },
        "recommendation_mode": {
          "$ref": "#/definitions/WorkflowRecommendationMode"
        },
        "source_of_truth_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkflowCollectPlanStep"
          }
        },
        "target": {
          "type": "string"
        },
        "target_class": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "workflow_recommendation_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_recommendation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "WorkflowCollectPlanStep": {
      "type": "object",
      "required": [
        "claim_gate",
        "command_argv",
        "continue_on",
        "expected_artifact_kinds",
        "expected_artifact_paths_or_globs",
        "human_summary",
        "phase",
        "requires_approval_policy",
        "requires_controller",
        "requires_privileged_helper",
        "requires_target_local",
        "step_id",
        "stop_on",
        "validation_after_step",
        "working_directory_policy"
      ],
      "properties": {
        "claim_gate": {
          "type": "string"
        },
        "command_argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continue_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GovernorValidity"
          }
        },
        "expected_artifact_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_artifact_paths_or_globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_summary": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "requires_approval_policy": {
          "type": "boolean"
        },
        "requires_controller": {
          "type": "boolean"
        },
        "requires_privileged_helper": {
          "type": "boolean"
        },
        "requires_target_local": {
          "type": "boolean"
        },
        "step_id": {
          "type": "string"
        },
        "stop_on": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GovernorValidity"
          }
        },
        "validation_after_step": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WorkflowContinuationRule": {
      "type": "object",
      "required": [
        "outcome",
        "semantics"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/definitions/GovernorValidity"
        },
        "semantics": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WorkflowRecommendationMode": {
      "type": "string",
      "enum": [
        "offline_recommendation",
        "capability_checked_recommendation"
      ]
    }
  }
}