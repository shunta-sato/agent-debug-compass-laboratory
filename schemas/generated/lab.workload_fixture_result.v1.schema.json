        "type": "string"
      }
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "fixture": {
      "type": "string"
    },
    "iterations": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "memory_bytes_touched": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "schema_version": {
      "type": "string"
    },
    "storage_bytes_written_and_cleaned": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
