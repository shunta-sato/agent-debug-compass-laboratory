{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact_for_WorkflowRecommendationPayload",
  "type": "object",
  "required": [
    "claims",
    "data_quality",
    "evidence_refs",
    "factors",
    "id",
    "kind",
    "metrics",
    "payload",
    "run_id",
    "schema",
    "status",
    "target_id",
    "time_unix_ms"
  ],
  "properties": {
    "bounds": {
      "anyOf": [
        {
          "$ref": "#/definitions/Bounds"
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Claim"
      }
    },
    "data_quality": {
      "$ref": "#/definitions/DataQuality"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factors": {
      "$ref": "#/definitions/Factors"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/Kind"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Metric"
      }
    },
    "payload": {
      "$ref": "#/definitions/WorkflowRecommendationPayload"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/Status"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Bounds": {
      "type": "object",
      "required": [
        "notes"
      ],
      "properties": {
        "duration_seconds_max": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "BuildInfo": {
      "type": "object",
      "required": [
        "build_profile",
        "git_sha",
        "name",
        "target_triple",
        "version"
      ],
      "properties": {
        "build_profile": {
          "type": "string"
        },
        "git_sha": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "target_triple": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": [
        "claim_id",
        "decision",
        "evidence_refs",
        "next_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/definitions/Decision"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQuality": {
      "type": "object",
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "$ref": "#/definitions/DataQualityLevel"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "DataQualityLevel": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "degraded"
      ]
    },
    "Decision": {
      "type": "string",
      "enum": [
        "supported",
        "provisional",
        "blocked"
      ]
    },
    "EvidenceRefusalCode": {
      "type": "string",
      "enum": [
        "invalid_artifact",
        "policy_violation",
        "unsupported_operation",
        "missing_evidence"
      ]
    },
    "Factors": {
      "type": "object",
      "required": [
        "confounders",
        "controlled",
        "observed"
      ],
      "properties": {
        "confounders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controlled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Kind": {
      "type": "string",
      "enum": [
        "inventory",
        "observation",
        "pressure",
        "composite",
        "control_result",
        "load",
        "workload",
        "report.run",
        "report.operating_contract",
        "report.suitability",
        "report.constraints",
        "report.constraints_check",
        "report.evidence_ref_resolution",
        "report.run_validation",
        "control.governor_sweep_policy",
        "workflow.recommendation",
        "workflow.collect_plan"
      ]
    },
    "Metric": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Status": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "measured_partial"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "insufficient"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "not_applicable"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "$ref": "#/definitions/EvidenceRefusalCode"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "refused"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "detail",
            "state"
          ],
          "properties": {
            "detail": {
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "unsafe_blocked"
              ]
            }
          }
        }
      ]
    },
    "WorkflowEvidencePolicy": {
      "type": "object",
      "required": [
        "causal_linkage_required",
        "forbidden_linkage_sources",
        "raw_primitives_are_claim_producing",
        "recommendation_is_target_measurement_evidence"
      ],
      "properties": {
        "causal_linkage_required": {
          "type": "boolean"
        },
        "forbidden_linkage_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_primitives_are_claim_producing": {
          "type": "boolean"
        },
        "recommendation_is_target_measurement_evidence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "WorkflowRecommendationMode": {
      "type": "string",
      "enum": [
        "offline_recommendation",
        "capability_checked_recommendation"
      ]
    },
    "WorkflowRecommendationPayload": {
      "type": "object",
      "required": [
        "controller_adc_lab",
        "evidence_policy",
        "expected_outputs",
        "forbidden_patterns",
        "goal",
        "must_not_use_for_claims",
        "must_use",
        "next_step",
        "recommendation_mode",
        "source_of_truth_chain",
        "target",
        "target_class",
        "target_id",
        "version_policy",
        "workflow_id"
      ],
      "properties": {
        "controller_adc_lab": {
          "$ref": "#/definitions/BuildInfo"
        },
        "evidence_policy": {
          "$ref": "#/definitions/WorkflowEvidencePolicy"
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "type": "string"
        },
        "must_not_use_for_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_use": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_step": {
          "type": "string"
        },
        "recommendation_mode": {
          "$ref": "#/definitions/WorkflowRecommendationMode"
        },
        "source_of_truth_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "target_class": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "version_policy": {
          "$ref": "#/definitions/WorkflowVersionPolicy"
        },
        "workflow_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "WorkflowVersionPolicy": {
      "type": "object",
      "required": [
        "allow_skew_override_records_gap",
        "claim_producing_run_requires_no_skew",
        "skew_blocks_fullset_measured_claims"
      ],
      "properties": {
        "allow_skew_override_records_gap": {
          "type": "boolean"
        },
        "claim_producing_run_requires_no_skew": {
          "type": "boolean"
        },
        "skew_blocks_fullset_measured_claims": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}