{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ControlResult",
  "type": "object",
  "required": [
    "operation_id",
    "plan_id",
    "restore_attempted",
    "result_id",
    "risk_tier",
    "schema_version",
    "status",
    "target_id",
    "time_unix_ms"
  ],
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "refusal": {
      "anyOf": [
        {
          "$ref": "#/definitions/Refusal"
        },
        {
          "type": "null"
        }
      ]
    },
    "restore_attempted": {
      "type": "boolean"
    },
    "restore_lease": {
      "anyOf": [
        {
          "$ref": "#/definitions/RestoreLease"
        },
        {
          "type": "null"
        }
      ]
    },
    "restore_result": {
      "anyOf": [
        {
          "$ref": "#/definitions/RestoreAttempt"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_id": {
      "type": "string"
    },
    "risk_tier": {
      "$ref": "#/definitions/RiskTier"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/ControlResultStatus"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AppliedState": {
      "type": "object",
      "required": [
        "governor"
      ],
      "properties": {
        "governor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CapturedState": {
      "type": "object",
      "required": [
        "cpufreq_policies"
      ],
      "properties": {
        "cpufreq_policies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CpufreqPolicyState"
          }
        }
      },
      "additionalProperties": false
    },
    "ControlResultStatus": {
      "type": "string",
      "enum": [
        "refused",
        "dry_run_ok",
        "applied",
        "restored",
        "failed"
      ]
    },
    "CpufreqPolicyState": {
      "type": "object",
      "required": [
        "governor",
        "policy"
      ],
      "properties": {
        "governor": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "scaling_max_freq": {
          "type": [
            "string",
            "null"
          ]
        },
        "scaling_min_freq": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Refusal": {
      "type": "object",
      "required": [
        "message",
        "reason_code"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/definitions/RefusalCode"
        }
      },
      "additionalProperties": false
    },
    "RefusalCode": {
      "type": "string",
      "enum": [
        "unsupported_operation",
        "approval_required",
        "approval_mismatch",
        "privileged_apply_requires_target_local_helper",
        "policy_violation",
        "invalid_plan",
        "missing_surface"
      ]
    },
    "RestoreAttempt": {
      "type": "object",
      "required": [
        "message",
        "status"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/RestoreAttemptStatus"
        }
      },
      "additionalProperties": false
    },
    "RestoreAttemptStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "RestoreLease": {
      "type": "object",
      "required": [
        "applied_state",
        "captured_state",
        "created_by_plan",
        "lease_id",
        "operation_id",
        "restore_required",
        "restore_status",
        "schema_version",
        "target_id",
        "time_unix_ms"
      ],
      "properties": {
        "applied_state": {
          "$ref": "#/definitions/AppliedState"
        },
        "captured_state": {
          "$ref": "#/definitions/CapturedState"
        },
        "created_by_plan": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "restore_required": {
          "type": "boolean"
        },
        "restore_status": {
          "$ref": "#/definitions/RestoreStatus"
        },
        "schema_version": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "time_unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "RestoreStatus": {
      "type": "string",
      "enum": [
        "pending",
        "restored",
        "failed",
        "dry_run"
      ]
    },
    "RiskTier": {
      "type": "string",
      "enum": [
        "tier0_read_only_observation",
        "tier1_low_risk_reversible_non_root",
        "tier2_privileged_reversible",
        "tier3_hard_to_restore",
        "tier4_normally_prohibited"
      ]
    }
  }
}