{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalRecord",
  "type": "object",
  "required": [
    "approval_id",
    "approved_actions",
    "approved_by",
    "approved_operation",
    "approved_plan_digest",
    "approved_plan_id",
    "bounds",
    "operation_summary",
    "restore_required",
    "risk_tier",
    "schema_version",
    "target_id",
    "time_unix_ms"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "approved_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "$ref": "#/definitions/Actor"
    },
    "approved_operation": {
      "$ref": "#/definitions/ControlOperation"
    },
    "approved_plan_digest": {
      "type": "string"
    },
    "approved_plan_id": {
      "type": "string"
    },
    "bounds": {
      "$ref": "#/definitions/ApprovalBounds"
    },
    "operation_summary": {
      "type": "string"
    },
    "restore_required": {
      "type": "boolean"
    },
    "risk_tier": {
      "$ref": "#/definitions/RiskTier"
    },
    "schema_version": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Actor": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ActorKind"
        }
      },
      "additionalProperties": false
    },
    "ActorKind": {
      "type": "string",
      "enum": [
        "agent",
        "human",
        "system"
      ]
    },
    "ApprovalBounds": {
      "type": "object",
      "required": [
        "duration_seconds_max"
      ],
      "properties": {
        "duration_seconds_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "thermal_celsius_abort": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "ControlOperation": {
      "type": "object",
      "required": [
        "desired_state",
        "operation_id"
      ],
      "properties": {
        "desired_state": {
          "$ref": "#/definitions/CpufreqDesiredState"
        },
        "operation_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CpufreqDesiredState": {
      "type": "object",
      "required": [
        "governor"
      ],
      "properties": {
        "governor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RiskTier": {
      "type": "string",
      "enum": [
        "tier0_read_only_observation",
        "tier1_low_risk_reversible_non_root",
        "tier2_privileged_reversible",
        "tier3_hard_to_restore",
        "tier4_normally_prohibited"
      ]
    }
  }
}