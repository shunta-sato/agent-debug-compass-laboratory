{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompositeBoundaryResult",
  "type": "object",
  "required": [
    "claim_blocked",
    "claim_supported",
    "controlled_factors",
    "coupling_evidence_class",
    "duration_ms",
    "evidence_refs",
    "next_evidence_needed",
    "observed_covariates",
    "phases",
    "result_id",
    "safety",
    "scenario",
    "schema_version",
    "status",
    "target_id",
    "time_unix_ms",
    "uncontrolled_confounders"
  ],
  "properties": {
    "claim_blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controlled_factors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContractFactor"
      }
    },
    "coupling_evidence_class": {
      "$ref": "#/definitions/ResourceCouplingEvidenceClass"
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_evidence_needed": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContractEvidenceGap"
      }
    },
    "observed_covariates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContractFactor"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CompositeBoundaryPhase"
      }
    },
    "result_id": {
      "type": "string"
    },
    "safety": {
      "$ref": "#/definitions/PressureSafety"
    },
    "scenario": {
      "$ref": "#/definitions/CompositeBoundaryScenario"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/ContractEvidenceStatus"
    },
    "target_id": {
      "type": "string"
    },
    "time_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "uncontrolled_confounders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CompositeBoundaryPhase": {
      "type": "object",
      "required": [
        "metrics",
        "phase_id",
        "pressure_kind",
        "status",
        "summary"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceMetric"
          }
        },
        "phase_id": {
          "type": "string"
        },
        "pressure_kind": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ContractEvidenceStatus"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "CompositeBoundaryScenario": {
      "type": "string",
      "enum": [
        "memory_storage_jitter"
      ]
    },
    "ContractEvidenceGap": {
      "type": "object",
      "required": [
        "blocking_missing_evidence",
        "needed_probe",
        "next_action",
        "owner_surface",
        "reason"
      ],
      "properties": {
        "blocking_missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needed_probe": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "owner_surface": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ContractEvidenceStatus": {
      "type": "string",
      "enum": [
        "measured",
        "measured_partial",
        "not_controllable",
        "unsafe_to_run_with_reason",
        "not_applicable_with_reason",
        "insufficient"
      ]
    },
    "ContractFactor": {
      "type": "object",
      "required": [
        "factor_id",
        "value"
      ],
      "properties": {
        "factor_id": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PressureSafety": {
      "type": "object",
      "required": [
        "abort_conditions",
        "cleanup",
        "cleanup_verified",
        "duration_seconds_max",
        "memory_bytes_max",
        "network_bytes_max",
        "storage_bytes_max"
      ],
      "properties": {
        "abort_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cleanup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cleanup_verified": {
          "type": "boolean"
        },
        "duration_seconds_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "memory_bytes_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "network_bytes_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "storage_bytes_max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ResourceCouplingEvidenceClass": {
      "type": "string",
      "enum": [
        "ingredients_only",
        "composite_measured",
        "coupling_not_measured"
      ]
    },
    "ResourceMetric": {
      "type": "object",
      "required": [
        "metric_id",
        "unit"
      ],
      "properties": {
        "metric_id": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    }
  }
}