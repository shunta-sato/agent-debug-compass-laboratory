{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.restore_lease.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "target_id", "operation_id", "captured_state", "applied_state", "restore_required", "restore_status", "created_by_plan", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.restore_lease.v1" },
    "lease_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "operation_id": { "enum": ["linux.cpufreq.set_governor"] },
    "captured_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpufreq_policies"],
      "properties": {
        "cpufreq_policies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy", "governor", "scaling_min_freq", "scaling_max_freq"],
            "properties": {
              "policy": { "type": "string", "minLength": 1 },
              "governor": { "enum": ["performance", "ondemand", "powersave", "schedutil", "userspace"] },
              "scaling_min_freq": { "type": ["string", "null"] },
              "scaling_max_freq": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "applied_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governor"],
      "properties": {
        "governor": { "enum": ["performance", "ondemand", "powersave", "schedutil", "userspace"] }
      }
    },
    "restore_required": { "type": "boolean" },
    "restore_status": { "enum": ["pending", "restored", "failed", "dry_run"] },
    "created_by_plan": { "type": "string", "minLength": 1 },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
