{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.suitability_policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "required_dimensions", "optional_dimensions", "rules", "thermal", "cpu", "memory"],
  "properties": {
    "schema_version": { "const": "lab.suitability_policy.v1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "required_dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
    "optional_dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_required_dimension_blocks_selection", "unknown_never_becomes_meet"],
      "properties": {
        "unknown_required_dimension_blocks_selection": { "const": true },
        "unknown_never_becomes_meet": { "const": true }
      }
    },
    "thermal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_temp_c", "marginal_margin_c_below"],
          "properties": {
            "max_temp_c": { "type": "number" },
            "marginal_margin_c_below": { "type": "number", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "cpu": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_process_cpu_percent_avg"],
          "properties": {
            "max_process_cpu_percent_avg": { "type": "number", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "memory": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_memory_margin_mb"],
          "properties": {
            "min_memory_margin_mb": { "type": "integer", "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "dimension": {
      "enum": ["cpu", "thermal", "memory", "storage_io", "network_io", "latency_jitter", "observer"]
    }
  }
}
