{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.run_set_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_set_id", "target_id", "target_class", "pack_status", "runs", "operations_summary", "included_surfaces", "evidence_refs", "blocked_evidence", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.run_set_manifest.v1" },
    "run_set_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "target_class": { "type": "string", "minLength": 1 },
    "pack_status": { "$ref": "#/$defs/pack_status" },
    "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run_entry" } },
    "operations_summary": { "type": "object", "additionalProperties": { "type": "string" } },
    "included_surfaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_gap" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "pack_status": {
      "enum": [
        "observational_read_only",
        "read_only_plus_pressure_probes",
        "exploratory_pressure_smoke",
        "controlled_governor_subset",
        "controlled_operating_point_subset",
        "composite_coupling_probe",
        "platform_operating_contract_candidate",
        "platform_operating_contract_reference"
      ]
    },
    "run_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_dir", "role", "evidence_refs", "operations_summary"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "run_dir": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "included_evidence"] },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "operations_summary": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "evidence_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "needed_probe", "blocking_missing_evidence", "next_action", "owner_surface"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "needed_probe": { "type": "string", "minLength": 1 },
        "blocking_missing_evidence": { "type": "array", "items": { "type": "string" } },
        "next_action": { "type": "string", "minLength": 1 },
        "owner_surface": { "enum": ["adc-lab", "target", "external_tool", "operator_approval"] }
      }
    }
  }
}
