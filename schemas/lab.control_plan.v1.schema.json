{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.control_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "run_id", "target_id", "risk_tier", "approval_required", "restore_required", "operation", "bounds", "created_by", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.control_plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "risk_tier": { "$ref": "#/$defs/risk_tier" },
    "approval_required": { "type": "boolean" },
    "restore_required": { "type": "boolean" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "desired_state"],
      "properties": {
        "operation_id": { "enum": ["linux.cpufreq.set_governor"] },
        "desired_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governor"],
          "properties": {
            "governor": { "enum": ["performance", "ondemand", "powersave", "schedutil", "userspace"] }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds_max", "thermal_celsius_abort"],
      "properties": {
        "duration_seconds_max": { "type": "integer", "minimum": 1 },
        "thermal_celsius_abort": { "type": ["number", "null"] }
      }
    },
    "created_by": { "$ref": "#/$defs/actor" },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "risk_tier": { "enum": ["tier0_read_only_observation", "tier1_low_risk_reversible_non_root", "tier2_privileged_reversible", "tier3_hard_to_restore", "tier4_normally_prohibited"] },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["agent", "human", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
