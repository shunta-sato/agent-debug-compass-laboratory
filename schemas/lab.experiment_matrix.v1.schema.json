{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.experiment_matrix.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "description", "factors", "warmup_seconds", "cooldown_seconds", "repetitions", "order"],
  "properties": {
    "schema_version": { "const": "lab.experiment_matrix.v1" },
    "matrix_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "levels"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["controlled_factor", "observed_covariate", "uncontrolled_confounder"] },
          "levels": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "warmup_seconds": { "type": "integer", "minimum": 0, "maximum": 60 },
    "cooldown_seconds": { "type": "integer", "minimum": 0, "maximum": 60 },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 10 },
    "order": { "enum": ["listed", "randomized"] }
  }
}
