{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.operating_point_coverage.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target_id", "covered_points", "blocked_points", "coverage_status", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.operating_point_coverage.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "covered_points": { "type": "array", "items": { "type": "string" } },
    "blocked_points": { "type": "array", "items": { "type": "string" } },
    "coverage_status": { "enum": ["supported", "provisional", "blocked"] },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
