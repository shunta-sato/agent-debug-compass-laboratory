{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.toolchain_inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "software_stack", "tools"],
  "properties": {
    "schema_version": { "const": "lab.toolchain_inventory.v1" },
    "target_id": { "type": "string", "minLength": 1 },
    "software_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "arch", "board"],
      "properties": {
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "arch": { "type": "string" },
        "board": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "category", "available", "privilege", "qualification"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["observation", "control", "load", "probe", "report_normalizer", "restore", "health_check", "observation_control"] },
          "available": { "type": "boolean" },
          "privilege": { "enum": ["none", "user", "sudo_helper", "root"] },
          "qualification": { "enum": ["builtin", "needs_control_test", "external_unqualified", "agent_created_unqualified", "qualified", "refused"] }
        }
      }
    }
  }
}
