{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.boundary_probe_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "target_id", "target_class", "probes", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.boundary_probe_plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "target_class": { "type": "string", "minLength": 1 },
    "probes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probe" } },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "string_list": { "type": "array", "items": { "type": "string" } },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "boundary", "controlled_factors", "observed_covariates", "uncontrolled_confounders", "safety_abort_condition", "restore_cleanup", "claim_supported", "claim_blocked"],
      "properties": {
        "probe_id": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "controlled_factors": { "$ref": "#/$defs/string_list" },
        "observed_covariates": { "$ref": "#/$defs/string_list" },
        "uncontrolled_confounders": { "$ref": "#/$defs/string_list" },
        "safety_abort_condition": { "$ref": "#/$defs/string_list" },
        "restore_cleanup": { "$ref": "#/$defs/string_list" },
        "claim_supported": { "type": "string", "minLength": 1 },
        "claim_blocked": { "type": "string", "minLength": 1 }
      }
    }
  }
}
