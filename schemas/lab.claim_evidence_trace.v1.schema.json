{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.claim_evidence_trace.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "target_id", "claims", "time_unix_ms"],
  "properties": {
    "schema_version": { "const": "lab.claim_evidence_trace.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "decision", "evidence_refs", "next_evidence_needed"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["supported", "blocked", "provisional"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "next_evidence_needed": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "time_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
